# ---------- dependencies ----------
node_modules/
.pnp
.pnp.js

# ---------- build output ----------
dist/
dist-ssr/
*.tsbuildinfo

# ---------- env / secrets (never commit) ----------
.env
.env.*
!.env.example

# ---------- convex local deployment state ----------
.convex/

# ---------- logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# ---------- editor / OS ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ---------- local tooling ----------
.vly-run/

# NOTE: src/convex/_generated/ is intentionally committed.
# The frontend imports it (src/pages/PortalPage.tsx, QuotePage.tsx), so a clean
# clone and the production build both need it present.
